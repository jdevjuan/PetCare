{
  "name": "petcare-monorepo",
  "private": true,
  "workspaces": [
    "shared",
    "api",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w api\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck -w frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}